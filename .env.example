# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 주세요. (.env.local 은 git에 올라가지 않아요)

# Pixabay 사진 검색 (서버 함수에서만 사용 — 절대 VITE_ 를 붙이지 마세요!)
PIXABAY_API_KEY=여기에_픽사베이_API_키

# 공공데이터포털(odcloud) 제주 데이터 — 선택. 없어도 제주 지도는 기본 명소로 동작해요. (VITE_ 금지)
ODCLOUD_API_KEY=여기에_공공데이터포털_인증키

# 기상청 단기예보 조회서비스(공공데이터포털 일반 인증키) — 선택. 지도에서 지금 날씨를 보여줘요. (VITE_ 금지)
DATA_GO_KR_KEY=여기에_공공데이터포털_인증키

# Supabase (Project Settings → API). VITE_ 로 시작하는 두 값은 브라우저에 공개돼요.
# anon(공개) 키는 공개해도 안전하도록 만들어진 키예요. service_role 키는 절대 넣지 마세요!
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키
